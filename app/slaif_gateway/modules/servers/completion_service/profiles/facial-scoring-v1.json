{
  "version": 1,
  "profile_id": "facial-scoring-v1",
  "module_id": "facial_scoring",
  "public_model": "facial-manipulation-scoring",
  "upstream_model": "facial-manipulation-scoring",
  "upstream_path": "/v1/score",
  "api_key_env_var": "FACIAL_SCORING_API_KEY",
  "auth_header": "X-API-Key",
  "auth_prefix": "",
  "request_mapping": "multipart_image",
  "response_mapping": "score_status",
  "image_media_types": ["image/png", "image/jpeg", "image/webp", "image/gif"],
  "max_image_data_url_bytes": 10485760,
  "max_response_bytes": 2097152,
  "request_error_code": "facial_scoring_request_invalid",
  "response_id_prefix": "chatcmpl-facial-"
}
