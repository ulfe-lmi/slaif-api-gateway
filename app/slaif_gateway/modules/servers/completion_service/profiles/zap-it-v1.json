{
  "version": 1,
  "profile_id": "zap-it-v1",
  "public_model": "zap-it-1",
  "upstream_model": "zap-it-1",
  "upstream_path": "/v1/responses",
  "api_key_env_var": "ZAP_IT_API_KEY",
  "auth_header": "Authorization",
  "auth_prefix": "Bearer ",
  "request_mapping": "responses_image_yaml",
  "response_mapping": "json_fields",
  "text_pointer": "/output/0/content/0/text",
  "request_image_output": true,
  "image_output": {
    "pointer": "/output/1/result",
    "media_type": "image/png",
    "max_decoded_bytes": 16777216
  },
  "response_checks": {
    "/status": "completed",
    "/output/0/type": "message",
    "/output/0/role": "assistant",
    "/output/0/content/0/type": "output_text",
    "/output/1/type": "image_generation_call",
    "/output/1/status": "completed"
  },
  "response_array_lengths": {"/output": 2, "/output/0/content": 1},
  "image_media_types": ["image/png", "image/jpeg", "image/webp"],
  "max_image_data_url_bytes": 10485760,
  "max_yaml_bytes": 262144,
  "max_response_bytes": 33554432,
  "result_schema_version": "zap-it.public.v1"
}
