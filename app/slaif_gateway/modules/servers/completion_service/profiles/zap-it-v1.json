{
  "version": 1,
  "profile_id": "zap-it-v1",
  "public_model": "zap-it-1",
  "upstream_model": "zap-it-1",
  "upstream_path": "/v1/responses",
  "api_key_env_var": "ZAP_IT_API_KEY",
  "auth_header": "Authorization",
  "auth_prefix": "Bearer ",
  "request_mapping": "responses_image_yaml",
  "response_mapping": "responses_json_text",
  "image_media_types": ["image/png", "image/jpeg", "image/webp"],
  "max_image_data_url_bytes": 10485760,
  "max_yaml_bytes": 262144,
  "max_response_bytes": 2097152,
  "result_schema_version": "zap-it.public.v1"
}
