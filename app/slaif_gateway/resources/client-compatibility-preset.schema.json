            "pattern": "(auth|secret|password|credential|header|cookie|provider|endpoint|capabilit|approval|permission|execution|connector|mcp|signing|token|budget|limit|quota|billing|cost|tool|stream|sandbox|api_key|apikey|bearer|session|thread|tenant|principal|identity|request_id|replay)"
