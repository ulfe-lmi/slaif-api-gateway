    "extensionName": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        {
          "not": {
            "enum": [
              "arguments",
              "audio",
              "background",
              "base_url",
              "cache_control",
              "call_id",
              "client_metadata",
              "content",
              "conversation",
              "data",
              "detail",
              "encoding",
              "encrypted_content",
              "file_data",
              "file_id",
              "file_url",
              "filename",
              "format",
              "id",
              "image_url",
              "include",
              "input",
